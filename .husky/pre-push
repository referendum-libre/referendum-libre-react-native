#!/usr/bin/env sh

echo ""
echo "🧪  Running tests before push…"
echo ""

if npm test --silent; then
  echo ""
  echo "✅  All tests passed — pushing."
  echo ""
else
  echo ""
  echo "❌  Tests failed — push aborted."
  echo "   Fix the failing tests, or use --no-verify to skip (not recommended)."
  echo ""
  exit 1
fi
